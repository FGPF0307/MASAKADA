# Salin menjadi .env lalu isi. Jangan commit .env.
PORT=4000
FRONTEND_URL=http://localhost:5173
# Supabase → Connect → Session pooler (tanpa tanda [ ] pada kata sandi)
DATABASE_URL=
SUPABASE_URL=https://PROJECT-ID.supabase.co
# Kunci rahasia (sb_secret_…) khusus server untuk unggah foto ke Storage
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=foto
# Chef AI: isi kunci Gemini untuk AI sungguhan. Kosong atau AI_MOCK=true → jawaban berskrip (demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_MOCK=true
